{
  "name": "@red-cup-engineering/web-mesh-engineering-services-section",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Peer-to-peer mesh networking over HTTP: Kademlia peer discovery, gossip and anti-entropy replication, content-addressed storage, DTN bundles, and a Nostr relay. Moved out of the HTTP section since it is a networking topology concern, not an HTTP-serving one.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./address": {
      "types": "./dist/address.d.mts",
      "import": "./dist/address.mjs"
    },
    "./antientropy": {
      "types": "./dist/antientropy.d.mts",
      "import": "./dist/antientropy.mjs"
    },
    "./content": {
      "types": "./dist/content.d.mts",
      "import": "./dist/content.mjs"
    },
    "./discovery": {
      "types": "./dist/discovery.d.mts",
      "import": "./dist/discovery.mjs"
    },
    "./dtn": {
      "types": "./dist/dtn.d.mts",
      "import": "./dist/dtn.mjs"
    },
    "./gossip": {
      "types": "./dist/gossip.d.mts",
      "import": "./dist/gossip.mjs"
    },
    "./nostr": {
      "types": "./dist/nostr.d.mts",
      "import": "./dist/nostr.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/http-edge-service": "workspace:*",
    "@red-cup-engineering/http-server-core-service": "workspace:*",
    "@red-cup-engineering/relating": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "8.61.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/web-mesh-engineering-services-section.git"
  },
  "license": "MIT",
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
